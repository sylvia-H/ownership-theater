    "test": "node --test \"src/**/*.test.ts\"",
    "verify:rust": "node scripts/verify-rust.mjs"
  },
  "dependencies": {
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
