{
  "name": "ownership-theater",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "所有權劇場：用執行軌跡演出 Rust 與 JS 的差別",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
